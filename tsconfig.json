{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "stackui-kit": ["../stackui/packages/react/src/index.ts"],
      "stackui-kit/barcode": ["../stackui/packages/react/src/barcode.ts"],
      "@zxing/*": ["./node_modules/@zxing/*"],
      "stackui-kit/styles.css": ["../stackui/packages/react/src/styles/index.css"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
